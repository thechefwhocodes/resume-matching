# =============================================================================
# Frontend (Next.js) -> Candidate Service URL
# =============================================================================
CANDIDATE_SERVICE_URL=http://localhost:8000

# =============================================================================
# Candidate Service (candidate-service/aashish)
# =============================================================================

# Postgres connection (matches docker-compose.yml in repo root)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resumes

# OpenAI API key. If unset, the service falls back to BM25-only retrieval and
# zero-vector embeddings during ingest. With a key, the service defaults to
# embed+rerank and computes real embeddings on first boot.
OPENAI_API_KEY=

# Model selection (override-able). Defaults are sensible for a take-home:
EMBED_MODEL=text-embedding-3-small
EXTRACT_MODEL=gpt-4o-mini
RERANK_MODEL=gpt-4o-mini

# Optional: hard-pin the approach. Accepted values:
# bm25 | bm25+rerank | embed | embed+rerank
# Leave unset to let the selector pick automatically based on OPENAI_API_KEY.
APPROACH_OVERRIDE=

# Path to jobs.json (relative to candidate-service/aashish/ or absolute).
# Defaults to ../../data/jobs.json so it works from the repo layout.
JOBS_JSON_PATH=../../data/jobs.json

# Pipeline tunables
RETRIEVAL_TOP_K=30
RESULT_TOP_K=10
RERANK_MIN_SCORE=50
